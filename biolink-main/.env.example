# Copy this file to .env or .env.local and replace the values below.
# Neon database connection
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT signing secret for session cookies
JWT_SECRET="replace-with-a-random-64-char-secret"

# KIM upload API key
KIM_API_KEY="replace-with-your-kim-api-key"

# Optional local app config
NODE_ENV="development"

# Seconds between two counted views from the same IP (600 = 10 min, use 1 for local testing)
VIEW_COOLDOWN_SECONDS="600"

# Fake visitor geo for local testing, e.g. "US:New York:40.71:-74.0" (leave empty in production)
# VIEWER_GEO=""
